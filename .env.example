# Supabase projekt (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://tvoj-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tvoj-anon-key
# SAMO server: zaobilazi RLS i služi za upis narudžbi. Nikad s NEXT_PUBLIC_ prefiksom,
# nikad u repozitorij ni u chat. Na Vercelu dodaj kao običnu (ne javnu) varijablu.
SUPABASE_SERVICE_ROLE_KEY=tvoj-service-role-key

# Pravi javni URL aplikacije (QR kod, linkovi).
NEXT_PUBLIC_SITE_URL=https://tvoja-radnja.vercel.app

# Slug radnje na koji se preusmjerava početna "/" stranica.
NEXT_PUBLIC_DEFAULT_SLUG=grill-box

# E-mail obavijest vlasniku o novoj narudžbi (neobavezno; bez ovoga se mailovi ne šalju).
# Treba domenu verificiranu u Resendu. RESEND_API_KEY je tajan: samo na serveru, nikad u repozitorij.
RESEND_API_KEY=tvoj-resend-kljuc
RESEND_FROM=Narudžbe <narudzbe@tvoja-domena.hr>

# Web push obavijesti vlasniku (generiraj: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ti@primjer.hr
